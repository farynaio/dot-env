# -*- mode: conf -*-
## This is an example for icewm 4.1.0 program definition file.
## It will be installed as /data/data/com.termux/files/usr/share/icewm/programs.
## Place your variants in /data/data/com.termux/files/usr/etc/icewm or in $HOME/.icewm.
## This file is intended to be customized by distributions.
##
## mostly obsolete, fixme

menu "Development" folder {
    prog "Emacs" emacs emacsclient -a "" -c
}

menu "WWW" folder {
     prog "Epiphany" ~/.icewm/epiphany.svg epiphany
}

menu "Document Viewers" folder {
     prog "Ocular" ~/.icewm/okular.png ocular
#    prog "DVI Previewer" xdvi xdvi
#    prog "Ghostview" ghostview gv
}

menu Graphics folder {
    prog "Gimp" gimp gimp
}

menu Music folder {
    prog "Tenacity" ~/.icewm/tenacity.svg tenacity
}

menu System folder {
    prog "Control Panel" redhat control-panel
}

