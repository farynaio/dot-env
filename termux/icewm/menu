# -*- mode: conf -*-
# This is an example for icewm 4.1.0 menu definition file.
# It will be installed as /data/data/com.termux/files/usr/share/icewm/menu.
# Place your variants in /data/data/com.termux/files/usr/etc/icewm or in $HOME/.icewm since
# modifications to this file will be overwritten when you reinstall icewm.

prog "Epiphany" ~/.icewm/epiphany.svg epiphany
prog "Terminal" ~/.icewm/terminal.svg lxterminal
prog "File Manager" ~/.icewm/thunar.svg pcmanfm
prog "Emacs" emacs emacsclient -a "" -c
prog "Gimp" gimp gimp
prog "Libreoffice" ~/.icewm/libreoffice.svg libreoffice
prog "Okular" ~/.icewm/okular.png okular
prog "Tenacity" ~/.icewm/tenacity.svg tenacity

menu "System" folder {
    prog "Control Panel" redhat control-panel
}