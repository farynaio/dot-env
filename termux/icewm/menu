prog Epiphany /data/data/com.termux/files/usr/share/icons/hicolor/scalable/apps/org.gnome.Epiphany.svg epiphany
prog "Terminal" xterm xfce4-terminal
prog "Thunar" /data/data/com.termux/files/usr/share/icons/hicolor/scalable/apps/org.xfce.thunar.svg thunar
