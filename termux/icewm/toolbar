# -*- mode: conf -*-
# This is an example for icewm 4.1.0 toolbar definition file.
# It will be installed as /data/data/com.termux/files/usr/share/icewm/toolbar.
# Place your variants in /data/data/com.termux/files/usr/etc/icewm or in $HOME/.icewm since
# modifications to this file will be overwritten when you reinstall icewm.

prog "Terminal" ~/.icewm/terminal.svg lxterminal
prog "File Manager" ~/.icewm/thunar.svg pcmanfm
prog "Web browser" ~/.icewm/epiphany.svg xdg-utils-xdg-open about:blank
prog "Emacs" emacs emacsclient -a "" -c