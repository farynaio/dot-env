# -*- mode: sh -*-

source $PREFIX/etc/bash.bashrc

export PS1='\W \$ '
export PATH="$HOME/bin:$PATH"
export EDITOR="vim"
export VISUAL="vim"
export GPG_TTY=$(tty)

# export DISPLAY=:0 MESA_LOADER_DRIVER_OVERRIDE=zink
# export VK_ICD_FILENAMES=$PREFIX/share/vulkan/icd.d/lvp_icd.aarch64.json
# export VK_ICD_FILENAMES=$PREFIX/share/vulkan/icd.d/freedreno_icd.aarch64.json
# export VK_ICD_FILENAMES=$PREFIX/share/vulkan/icd.d/wrapper_icd.aarch64.json
# export ZINK_DESCRIPTORS=lazy
# export MESA_GL_VERSION_OVERRIDE=4.3COMPAT

my_emacs_run() {
  if [ -t 0 ]; then
    eval $EDITOR
  else
    eval $VISUAL
  fi
}

alias pkgu="pkg update"
alias pkgup="pkg upgrade"
alias pkgc="pkg autoclean"
alias pkgls="pkg list-installed"
alias pkglsi="pkgls | grep '\[installed\]'"
alias pkgs="pkg search "
alias pkgf="pkg files "
alias pkgd="pkg show "
alias pkgi="pkg install "
alias pkgrm="pkg uninstall "
alias pkglsu="apt list --upgradable"
alias g="git"
alias e="my_emacs_run"
alias notmuch-rm="notmuch search --format=text0 --output=files tag:deleted | xargs -0 --no-run-if-empty rm"